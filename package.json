{
  "name": "running-page",
  "description": "Geng Niu's Personal Running Dashboard",
  "version": "3.0.0",
  "author": "Geng Niu",
  "packageManager": "pnpm@8.9.0+sha256.8f5264ad1d100da11a6add6bb8a94c6f1e913f9e9261b2a551fabefad2ec0fec",
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "html-to-image": "^1.11.13",
    "mapbox-gl": "^3.23.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "vite": "^8.0.10"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "data:clean": "rm -f run_page/data.db src/static/activities.json",
    "build": "vite build",
    "develop": "vite dev",
    "dev": "vite dev",
    "serve": "vite serve",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "check": "prettier --check \"src/main.tsx\" \"src/**/*.{css,module.css,json,ts,tsx}\" \"*.{yaml,json,ts}\" \"eslint.config.mjs\"",
    "format": "prettier --write \"src/main.tsx\" \"src/**/*.{css,module.css,json,ts,tsx}\" \"*.{yaml,json,ts}\" \"eslint.config.mjs\"",
    "ci": "pnpm run format && pnpm run lint && pnpm run build"
  },
  "engineStrict": true,
  "browserslist": "defaults, not ie 11",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NiuGeng-SEU/running_page"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.0",
    "@eslint/js": "^10.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
